[0.400, "o", "\r\n"]
[0.613, "o", "\r\nx402  (wasit test)\r\n"]
[0.000, "o", "  X402-01  402 Response Status\r\n      An unpaid request must be answered with status code 402.\r\n"]
[0.000, "o", "  X402-02  Payment Header Present\r\n"]
[0.000, "o", "      The 402 response must include a payment header.\r\n"]
[0.000, "o", "  X402-03  Header Payload Decodable\r\n      The header value must be valid base64 that decodes to JSON.\r\n"]
[0.000, "o", "  X402-04  Required Fields Present\r\n"]
[0.000, "o", "      The payload must include the core payment terms, under the field names its advertised version requires.\r\n"]
[0.000, "o", "  X402-05  Network Identifier Valid\r\n"]
[0.000, "o", "      The network identifier must follow CAIP-2 (stellar:testnet or stellar:pubnet).\r\n  X402-06  Signature Resubmit Accepted  [costs funds]\r\n"]
[0.000, "o", "      A resubmitted request carrying a valid signature must be accepted.\r\n"]
[0.000, "o", "  X402-07  Invalid Signature Rejected  [negative, costs funds]\r\n      A deliberately corrupted signature must be rejected, not accepted.\r\n\r\n7 checks.\r\n"]
