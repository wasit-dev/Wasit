[6.106, "o", "\u001b[7mnpx -y @wasit-dev/cli@0.4.0 che\u001b[7mc\u001b[7mks --protocol x402\u001b[27m\u001b[K"]
[0.225, "o", "\u001b[A\u001b[31C\u001b[27mn\u001b[27mp\u001b[27mx\u001b[27m \u001b[27m-\u001b[27my\u001b[27m \u001b[27m@\u001b[27mw\u001b[27ma\u001b[27ms\u001b[27mi\u001b[27mt\u001b[27m-\u001b[27md\u001b[27me\u001b[27mv\u001b[27m/\u001b[27mc\u001b[27ml\u001b[27mi\u001b[27m@\u001b[27m0\u001b[27m.\u001b[27m4\u001b[27m.\u001b[27m0\u001b[27m \u001b[27mc\u001b[27mh\u001b[27mec\u001b[27mk\u001b[27ms\u001b[27m \u001b[27m-\u001b[27m-\u001b[27mp\u001b[27mr\u001b[27mo\u001b[27mt\u001b[27mo\u001b[27mc\u001b[27mo\u001b[27ml\u001b[27m \u001b[27mx\u001b[27m4\u001b[27m0\u001b[27m2\u001b[?2004l\r\r\n"]
[0.562, "o", "\r\nx402  (wasit test)\r\n"]
[0.000, "o", "  X402-01  402 Response Status\r\n"]
[0.000, "o", "      An unpaid request must be answered with status code 402.\r\n"]
[0.000, "o", "  X402-02  Payment Header Present\r\n"]
[0.001, "o", "      The 402 response must include a payment header.\r\n  X402-03  Header Payload Decodable\r\n      The header value must be valid base64 that decodes to JSON.\r\n  X402-04  Required Fields Present\r\n      The payload must include the core payment terms, under the field names its advertised version requires.\r\n"]
[0.000, "o", "  X402-05  Network Identifier Valid\r\n"]
[0.000, "o", "      The network identifier must follow CAIP-2 (stellar:testnet or stellar:pubnet).\r\n"]
[0.000, "o", "  X402-06  Signature Resubmit Accepted  [costs funds]\r\n      A resubmitted request carrying a valid signature must be accepted.\r\n  X402-07  Invalid Signature Rejected  [negative, costs funds]\r\n      A deliberately corrupted signature must be rejected, not accepted.\r\n\r\n7 checks.\r\n"]
[0.007, "o", "⠙"]
[0.001, "o", "\u001b[1G"]
[0.000, "o", "\u001b[0K"]
