{
  "name": "wasit",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w packages/core && npm run build -w packages/cli && npm run build -w packages/server",
    "test": "npm run test --workspaces --if-present",
    "verify:clean-install": "node scripts/verify-clean-install.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "typescript": "$typescript"
  }
}
