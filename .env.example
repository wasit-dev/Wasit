# Wasit configuration.
#
# Copy to .env and fill in. Every value below is testnet-only: Wasit runs real
# payment flows, and several checks settle real transactions. Never point this
# file at pubnet keys.
#
#   cp .env.example .env

# --- Network -----------------------------------------------------------------
# CAIP-2 network identifier. Only stellar:testnet and stellar:pubnet parse;
# pubnet has no default RPC endpoint, so it requires an explicit --rpc-url.
MPP_STELLAR_NETWORK=stellar:testnet

# --- x402 payment checks (X402-06, X402-07) ----------------------------------
# Payer secret key (S...). Without it, X402-06/07 are skipped and only the
# read-only checks run. These checks settle real payments — see docs/CHECKS.md.
STELLAR_PRIVATE_KEY=

# Recipient address (G...) used by the x402 fixture server as its payTo.
# Only needed to run the bundled fixture, not to test a third-party service.
STELLAR_PAYEE_ADDRESS=

# --- x402 payment checks on Base Sepolia (eip155:84532) ---------------------
# Payer private key (0x + 64 hex) for --network eip155:84532. It needs Base
# Sepolia USDC and no ETH: the facilitator pays the gas (EIP-3009).
EVM_PRIVATE_KEY=

# Recipient address (0x...) the Base Sepolia fixture server charges to.
# Only needed to run the bundled fixture.
EVM_PAYEE_ADDRESS=

# --- MPP charge mode (MPP-01) ------------------------------------------------
# Payer secret key (S...) for the charge check. Settles a real payment on every
# run; repeated runs spend repeatedly.
MPP_PAYER_SECRET=
MPP_PAYER_PUBLIC=

# Recipient the charge fixture bills to, and the secret it signs with.
# Fixture-only.
MPP_RECIPIENT=
MPP_RECIPIENT_SECRET=
MPP_SECRET_KEY=

# --- MPP channel mode (MPP-10 .. MPP-14) -------------------------------------
# Raw ed25519 seed, hex, used to sign channel commitments. Required by every
# channel check.
COMMITMENT_SECRET_HEX=
COMMITMENT_PUBKEY_HEX=

# Channel address (C...) this run asserts the target bills through. This is an
# assertion, not a selector: when it differs from the channel the target
# advertises, MPP-10 fails rather than inspecting the wrong contract.
CHANNEL_CONTRACT=

# A channel you own and are willing to destroy. MPP-13 closes it permanently.
CHANNEL_CONTRACT_DISPOSABLE=

# Deployment artefacts for opening new test channels. Not used by any check.
CHANNEL_FACTORY_CONTRACT=
CHANNEL_WASM_HASH=

# --- Wallet setup (wasit wallet) ---------------------------------------------
# Optional. An account you already funded with testnet USDC via
# https://faucet.circle.com. When set, `wasit wallet fund --role <role>
# --asset usdc` sends from it automatically instead of just printing manual
# faucet instructions. There is no scriptable USDC faucet, so this is the
# only way to automate the second run onward.
WASIT_USDC_DISTRIBUTOR_SECRET=

# --- MCP server --------------------------------------------------------------
# Set to 1 to register the destructive close tool. Omit it and the tool does
# not appear in tools/list at all. See docs/guides/mcp.md.
# WASIT_ALLOW_DESTRUCTIVE=1

# Absolute path to docs/CHECKS.md. The server walks up from its own location to
# find it, which fails when an MCP client launches it from an unrelated cwd.
# WASIT_CHECKS_PATH=/absolute/path/to/wasit/docs/CHECKS.md
