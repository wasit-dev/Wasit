{
  "name": "@wasit-dev/server",
  "version": "0.4.0",
  "description": "MCP server exposing Wasit's x402/MPP conformance checks as tools for Claude Code and other MCP-compatible agents.",
  "type": "module",
  "bin": {
    "wasit-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "docs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wasit-dev/wasit.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/wasit-dev/wasit#readme",
  "bugs": {
    "url": "https://github.com/wasit-dev/wasit/issues"
  },
  "keywords": [
    "stellar",
    "x402",
    "mpp",
    "mcp",
    "model-context-protocol",
    "conformance-testing"
  ],
  "author": "Muhammad Dzakwan Najmi",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "node -e \"const fs=require('fs');fs.mkdirSync('docs',{recursive:true});fs.copyFileSync('../../docs/CHECKS.md','docs/CHECKS.md')\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@wasit-dev/core": "^0.4.0",
    "zod": "^4.4.3"
  }
}
