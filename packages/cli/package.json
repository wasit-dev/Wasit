{
  "name": "@wasit-dev/cli",
  "version": "0.4.0",
  "description": "CLI for x402/MPP protocol-conformance testing on Stellar \u2014 verifies a service's payment flow settles on-chain per spec.",
  "type": "module",
  "bin": {
    "wasit": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wasit-dev/wasit.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/wasit-dev/wasit#readme",
  "bugs": {
    "url": "https://github.com/wasit-dev/wasit/issues"
  },
  "keywords": [
    "stellar",
    "x402",
    "mpp",
    "soroban",
    "conformance-testing",
    "cli",
    "payments"
  ],
  "author": "Muhammad Dzakwan Najmi",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test \"test/unit/**/*.test.ts*\"",
    "typecheck": "tsc -p test/tsconfig.json"
  },
  "dependencies": {
    "@wasit-dev/core": "^0.4.0",
    "cfonts": "^3.3.1",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "ink": "^7.1.1",
    "ink-select-input": "^6.2.0",
    "ink-text-input": "^6.0.0",
    "ora": "^9.4.1",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.1"
  }
}
