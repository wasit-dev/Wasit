# Dependencies
node_modules/
/.pnp
.pnp.*

# Build output — generated by `npm run build`, never committed
dist/
/out/
/build

# Next.js (frontend/) — generated at dev/build time, never hand-edited.
# AGENTS.md is re-written by `next dev` itself (see the file's own
# header) — removing it from git only re-creates it as an untracked
# file on the next `npm run dev`, so it stays ignored rather than
# tracked-and-deleted-forever.
.next/
next-env.d.ts
*.tsbuildinfo
frontend/AGENTS.md
frontend/CLAUDE.md

# Generated at publish time by packages/server's prepack script — copy of the
# root docs/CHECKS.md bundled into the published package, never hand-edited
packages/server/docs/

# Secrets
.env
.env.local
.env*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Editor / OS
.DS_Store
*.pem

# Vercel
.vercel

# Testing
/coverage

# Local fixture pids and logs — generated by scripts/fixtures.sh
.fixtures/

# Raw screen recordings — large binaries. Keep them in docs/media/ locally,
# publish them as GitHub Release assets rather than committing them.
docs/media/*.mov
docs/media/*.mp4
docs/media/*.webm
